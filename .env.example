# Copy to .env and fill locally. .env is ignored by git.
# Do not paste real keys into code, reports, or memory files.

# --- Public / external path -------------------------------------------------
# Standard Anthropic API key, used by the `claude` proposal generator and the
# Claude Code CLI worker. Create one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional: point at an Anthropic-compatible gateway instead of the public API.
# ANTHROPIC_BASE_URL=

# Optional overrides (all have sensible defaults):
# MODEL_DIR=            # root of local HF snapshots, e.g. $MODEL_DIR/Qwen/Qwen2.5-32B-Instruct
# CLAUDE_CMD=claude     # command used to invoke the Claude Code CLI worker
# MLE_PYTHON=           # python used for benchmark training (default: current interpreter)
# MLS_BENCH_ROOT=       # MLS-Bench checkout (default: external/MLS-Bench)
# MLE_DATA_DIR=         # prepared mle-bench data (default: external/mlebench_data)

# --- Internal-only (lab infrastructure; not needed externally) ---------------
# Runway LLM proxy gateway. No default is shipped; external users should use
# the standard Anthropic API path above instead.
# RUNWAY_BASE_URL=
RUNWAY_OPUS47_API_KEY=
RUNWAY_OPUS47_MODEL=claude-opus-4-7

RUNWAY_GPT55_API_KEY=
RUNWAY_GPT55_MODEL=gpt-5.5

# PAI-DLC helper script location (internal cluster submission only).
# PAI_MANAGE=/root/.claude/skills/pai/scripts/pai_manage.py
# Root of proposal_rl experiment checkpoints for the V2.3 formal sweep.
# PROPOSAL_RL_RUNS_ROOT=../proposal_rl/runs
