# Copy to .env and fill locally. .env is ignored by git.
# Do not paste real keys into code, reports, or memory files.

RUNWAY_FABLE5_API_KEY=
RUNWAY_FABLE5_MODEL=claude-fable-5
RUNWAY_FABLE5_MAAS_API_KEY=
RUNWAY_FABLE5_MAAS_MODEL="Claude Fable 5"
RUNWAY_FABLE5_MAAS_URL=https://maas.devops.rednote.life/openai/openai/google/anthropic/v1:streamRawPredict

RUNWAY_OPUS47_API_KEY=
RUNWAY_OPUS47_MODEL=claude-opus-4-7

RUNWAY_OPUS48_API_KEY=
RUNWAY_OPUS48_MODEL=claude-opus-4-8
# Optional: when set, the proxy routes Opus 4.8 through MaaS streamRawPredict
# while preserving the same local Anthropic-compatible /v1/messages interface.
RUNWAY_OPUS48_MAAS_API_KEY=
RUNWAY_OPUS48_MAAS_MODEL="claude opus 4.8"
RUNWAY_OPUS48_MAAS_URL=https://maas.devops.rednote.life/openai/openai/google/anthropic/v1:streamRawPredict

RUNWAY_GPT55_API_KEY=
RUNWAY_GPT55_MODEL=gpt-5.5
RUNWAY_GPT55_MAAS_API_KEY=
RUNWAY_GPT55_MAAS_MODEL=gpt-5.5
RUNWAY_GPT55_MAAS_URL=https://maas.devops.xiaohongshu.com/openai/openai/chat/completions?api-version=2024-12-01-preview
