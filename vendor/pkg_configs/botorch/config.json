{
  "base_image": "pytorch/pytorch:2.5.1-cuda12.1-cudnn9-devel",
  "install_cmds": [
    "apt-get update && apt-get install -y git build-essential",
    "pip install gpytorch>=1.12 linear_operator>=0.5.2",
    "SETUPTOOLS_SCM_PRETEND_VERSION=0.11.1 pip install /workspace/botorch",
    "pip install scipy matplotlib"
  ],
  "env": {
    "PYTHONPATH": "/workspace/botorch:${PYTHONPATH}"
  },
  "use_cuda": true,
  "workdir": "/workspace"
}
