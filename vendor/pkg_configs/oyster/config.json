{
  "base_image": "nvidia/cuda:11.3.1-cudnn8-devel-ubuntu20.04",
  "install_cmds": [
    "apt-get update && apt-get install -y --no-install-recommends git wget build-essential libosmesa6-dev libgl1-mesa-glx libglew-dev patchelf && rm -rf /var/lib/apt/lists/*",
    "mkdir -p /root/.mujoco && wget -q https://github.com/deepmind/mujoco/releases/download/2.1.0/mujoco210-linux-x86_64.tar.gz -O /tmp/mujoco.tar.gz && tar xzf /tmp/mujoco.tar.gz -C /root/.mujoco/ && rm /tmp/mujoco.tar.gz",
    "export MUJOCO_PY_MUJOCO_PATH=/root/.mujoco/mujoco210 && export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/root/.mujoco/mujoco210/bin && pip install 'cython<3' mujoco-py==2.1.2.14",
    "pip install torch==1.11.0+cu113 --extra-index-url https://download.pytorch.org/whl/cu113",
    "pip install gym==0.25.2 click gtimer numpy mujoco==2.3.7 python-dateutil joblib"
  ],
  "local_install_cmds": [
    "conda install -y -c conda-forge patchelf glew mesalib",
    "mkdir -p $HOME/.mujoco && wget -q https://github.com/deepmind/mujoco/releases/download/2.1.0/mujoco210-linux-x86_64.tar.gz -O /tmp/mujoco.tar.gz && tar xzf /tmp/mujoco.tar.gz -C $HOME/.mujoco/ && rm /tmp/mujoco.tar.gz",
    "MUJOCO_PY_MUJOCO_PATH=$HOME/.mujoco/mujoco210 LD_LIBRARY_PATH=$HOME/.mujoco/mujoco210/bin:${LD_LIBRARY_PATH} pip install 'cython<3' mujoco-py==2.1.2.14",
    "pip install torch==2.5.1 --index-url https://download.pytorch.org/whl/cu121",
    "pip install gym==0.25.2 click gtimer numpy mujoco==2.3.7 python-dateutil joblib"
  ],
  "env": {
    "MUJOCO_PY_MUJOCO_PATH": "/root/.mujoco/mujoco210",
    "LD_LIBRARY_PATH": "/root/.mujoco/mujoco210/bin:/usr/local/nvidia/lib64:${LD_LIBRARY_PATH}",
    "MUJOCO_GL": "osmesa",
    "PYTHONPATH": "/workspace/oyster:${PYTHONPATH}",
    "HOME": "/root"
  },
  "local_env": {
    "MUJOCO_PY_MUJOCO_PATH": "$HOME/.mujoco/mujoco210",
    "LD_LIBRARY_PATH": "$HOME/.mujoco/mujoco210/bin:/usr/lib/nvidia:/usr/lib/x86_64-linux-gnu:${LD_LIBRARY_PATH}",
    "MUJOCO_GL": "egl"
  },
  "use_cuda": true,
  "workdir": "/workspace"
}
